include *.md
include LICENSE
include config.yaml
include pyproject.toml

graft core
graft plugins
graft extensions
graft shared
graft services
graft web

recursive-include core *.pyi *.typed
recursive-include shared *.pyi *.typed

exclude .gitignore
exclude .env.example
exclude .pre-commit-config.yaml
prune .github
prune tests
prune docs
prune scripts
prune docker
